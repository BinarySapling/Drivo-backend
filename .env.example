# ─── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/drivo
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/drivo?retryWrites=true&w=majority
# Connection pool (optional tuning)
MONGO_POOL_MAX=10
MONGO_POOL_MIN=2

# ─── JWT ──────────────────────────────────────────────
JWT_ACCESS_SECRET=your_access_token_secret_change_in_production
JWT_REFRESH_SECRET=your_refresh_token_secret_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Redis Cloud / Upstash: rediss://<username>:<password>@<host>:<port>

# ─── Session ──────────────────────────────────────────
SESSION_SECRET=your_session_secret_change_in_production

# ─── Cloudinary ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Frontend URL (CORS) ──────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Email (OTP delivery) ─────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=<your_email>@gmail.com
EMAIL_PASS=<your_app_password>

# ─── Rate Limiting (Redis-backed) ─────────────────────
RATE_LIMIT_WINDOW_MS=900000      # 15 minutes in ms
RATE_LIMIT_MAX_REQUESTS=100      # global: reqs per window per IP
AUTH_RATE_LIMIT_MAX=10           # auth endpoints: reqs per 15min per IP
OTP_RATE_LIMIT_MAX=3             # OTP endpoints: reqs per 10min per IP

# ─── Account Lockout ──────────────────────────────────
LOCKOUT_MAX_ATTEMPTS=5           # failed logins before lockout
LOCKOUT_DURATION_MINUTES=15      # lockout duration

# ─── RabbitMQ (OTP async delivery) ────────────────────
RABBITMQ_URL=amqp://localhost:5672
# CloudAMQP (managed): amqps://<username>:<password>@<host>/<vhost>

# ─── CSRF Protection ──────────────────────────────────
# Must be at least 32 characters long
CSRF_SECRET=your_csrf_secret_at_least_32_characters_long_change_in_production

# ─── SUPERADMIN Seeder ────────────────────────────────────────────────────────
# Run once: node src/seeders/superadmin.js  (idempotent)
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@drivo.com
SUPERADMIN_PASSWORD=<your_secure_password>
